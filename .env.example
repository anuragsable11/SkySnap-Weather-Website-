# Copy this file to .env and fill in the values. Never commit .env.

# Required: your OpenWeather API key.
# Get a free one at https://home.openweathermap.org/api_keys
API_KEY=

# Optional: only needed if you deploy the site somewhere public.
# SECRET_KEY=replace-with-a-long-random-string
# DEBUG=False
# ALLOWED_HOSTS=yourdomain.com

# Optional: turns on the AI weather notes (summary, what to wear, health tips).
# Free: create a key at https://console.groq.com/keys (no credit card needed).
GROQ_API_KEY=

# Optional: the Groq chat model that writes the notes.
# GROQ_MODEL=openai/gpt-oss-20b

# Optional: Hugging Face instead of Groq. Its free plan only has a small
# monthly credit. Used only when GROQ_API_KEY is empty. Create a fine-grained
# token with the "Make calls to Inference Providers" permission at
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: the Hugging Face model. Any chat model served by
# Hugging Face Inference Providers works.
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct:novita
